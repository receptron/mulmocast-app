    "@graphai/vanilla": "^2.0.12",
    "@lucide/vue": "^1.52.0",
    "@monaco-editor/loader": "^1.7.0",
    "@mozilla/readability": "^0.6.0",
    "@receptron/event_agent_generator": "^0.0.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tato30/vue-pdf": "^2.2.0",
    "@vueuse/core": "^15.0.0",
    "adm-zip": "^0.6.1",
    "class-variance-authority": "^0.7.1",
    "clone-deep": "^4.0.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "deep-equal": "^2.2.3",
    "dompurify": "^3.4.16",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "exa-js": "^2.25.0",
    "ffmpeg-ffprobe-static": "^6.1.2-rc.1",
    "graphai": "^2.0.18",
    "monaco-editor": "^0.55.1",
    "monaco-yaml": "^5.5.1",
    "mulmocast": "^2.17.0",
    "node-fetch": "^2.7.0",
    "pinia": "^3.0.4",
    "punycode": "^2.3.1",
    "puppeteer": "25.12.0",
