    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "unicorn-magic": "0.2.0"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.71.0",
    "@graphai/llm_agents": "^2.1.0",
